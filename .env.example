# ─────────────────────────────────────────────────────────────
# Local Nano Banana alternative — environment configuration
# Copy to .env. Defaults work out of the box (Qwen editor, ungated).
# ─────────────────────────────────────────────────────────────

# ── Editor backend ──────────────────────────────────────────
# qwen -> Qwen-Image-Edit-2509 (Apache-2.0, ungated, commercial-OK) [default]
# flux -> FLUX.1 Kontext [dev]  (gated + non-commercial; needs HF_TOKEN below)
EDITOR_BACKEND=qwen
QWEN_EDIT_MODEL_ID=Qwen/Qwen-Image-Edit-2509
QWEN_TRUE_CFG=4.0
MODEL_ID=black-forest-labs/FLUX.1-Kontext-dev

# Hugging Face token — only needed for EDITOR_BACKEND=flux (gated model):
# accept the license at https://huggingface.co/black-forest-labs/FLUX.1-Kontext-dev
# then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# torch dtype: bfloat16 (recommended on GB10) | float16 | float32
TORCH_DTYPE=bfloat16
# Default diffusion settings (overridable per-request)
DEFAULT_STEPS=28
DEFAULT_GUIDANCE=2.5

# ── Composite path (real-photo subjects: segment + generate scene + place) ──
SEG_MODEL=ZhengPeng7/BiRefNet
BG_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SUBJECT_SCALE=0.6
SUBJECT_VPOS=0.92

# ── Redis (shared by api + worker) ──────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Storage ─────────────────────────────────────────────────
# Shared volume mount for uploads + results (both containers).
DATA_DIR=/data
# Delete finished jobs' files older than this many hours (0 = never).
RESULT_TTL_HOURS=24

# ── Limits / validation ─────────────────────────────────────
MAX_UPLOAD_MB=20
MAX_OUTPUT_DIM=4096
MAX_PROMPT_CHARS=2000

# ── Ecom resize presets ─────────────────────────────────────
# Which preset "recommended ecom sizing" maps to: shopify | amazon | generic
DEFAULT_ECOM_PRESET=shopify

# ── API ─────────────────────────────────────────────────────
API_PORT=8000
# CORS origins allowed to call the API from a browser (comma-separated).
# "*" = any origin — convenient if the frontend is hosted separately.
ALLOW_ORIGINS=*

# Access key. If set, callers must send X-API-Key: <key>. Empty = open.
API_KEY=

# ── Prompt-engineering layer + auto-router ──────────────────
# Expands terse prompts into rich instructions, and (in mode=auto) classifies
# the subject as graphic vs photo to pick the editor vs composite path.
ENHANCER_ENABLED=true
# Backend:
#   vlm      -> vision model that SEES the image (recommended; powers auto-router)
#   local    -> text-only instruct model in the worker (rewrites blind)
#   openai   -> call an OpenAI-compatible endpoint (e.g. your own LiteLLM/vLLM)
#   template -> deterministic template only, no LLM
ENHANCER_BACKEND=vlm
ENHANCER_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
ENHANCER_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct
# The following apply only when ENHANCER_BACKEND=openai:
ENHANCER_BASE_URL=http://qwen-litellm:4000/v1
ENHANCER_MODEL=qwen3-coder
ENHANCER_API_KEY=
